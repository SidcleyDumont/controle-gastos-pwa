{
  "rewrites": [
    { "source": "/((?!.*\\.pdf$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/pdf" }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "staging": true
    }
  }
}
